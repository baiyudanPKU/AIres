# 以下是Joker提供的测试密钥，仅供测试使用
DEEPSEEK_API_KEY=sk-57f93638c81b4c87a6b67cf9955a90ca

# API 基础 URL（默认：https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（默认：deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

